<?php
/**
 * Block template "Atlas plate" for Asset blocks: each asset on a specimen
 * plate with a mono caption; several assets sit side by side.
 */
$escape = $this->plugin('escapeHtml');
?>
<div class="atlas-plates">
<?php foreach ($attachments as $attachment): ?>
    <?php $asset = $attachment['asset']; ?>
    <?php if (!$asset) continue; ?>
    <?php $page = array_key_exists('page', $attachment) ? $attachment['page'] : null; ?>
    <figure class="atlas-plate">
        <?php if ($page): ?><a href="<?php echo $escape($page->siteUrl()); ?>"><?php endif; ?>
        <img src="<?php echo $escape($asset->assetUrl()); ?>" alt="<?php echo $escape($asset->altText() ?: ''); ?>">
        <?php if ($page): ?></a><?php endif; ?>
        <?php if ($attachment['caption'] !== '' || $page): ?>
        <figcaption>
            <?php if ($page): ?><a href="<?php echo $escape($page->siteUrl()); ?>"><?php echo $escape($attachment['alt_link_title'] !== '' ? $attachment['alt_link_title'] : $page->title()); ?></a><?php if ($attachment['caption'] !== ''): ?> — <?php endif; ?><?php endif; ?>
            <?php echo $escape($attachment['caption']); ?>
        </figcaption>
        <?php endif; ?>
    </figure>
<?php endforeach; ?>
</div>
